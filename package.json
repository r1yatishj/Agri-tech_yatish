{
  "name": "agri-tech-monorepo",
  "version": "1.0.0",
  "description": "Agri-Tech: Full-Stack MERN Smart Agriculture & Farm Management Platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node backend/src/server.js",
    "seed": "npm run seed --prefix backend"
  },
  "keywords": [
    "mern",
    "agri-tech",
    "agriculture",
    "smart-farming",
    "iot-monitoring",
    "farmer-support"
  ],
  "author": "Yatish Jangid",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
